{
  "name": "naturels-voices",
  "productName": "Naturels Voices",
  "version": "1.0.0",
  "description": "Lecteur de texte à voix haute avec voix neuronales, surlignage mot à mot et export MP3 (web et bureau).",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev:mock": "TTS_PROVIDER=mock node src/server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "msedge-tts": "^2.1.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.naturelsvoices.app",
    "productName": "Naturels Voices",
    "npmRebuild": false,
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "package.json"
    ],
    "icon": "electron/icon.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
